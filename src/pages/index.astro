---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Shel's Art — Original Oil Paintings">

  <!-- Hero -->
  <section class="hero">
    <p class="hero-label">Original Oil Paintings</p>
    <div class="hero-image">
      <img
        src="/images/IMG_0168.jpg"
        alt="Milk and Honey, Part 2 — oil on canvas still life with a painted jug, tangerine, bread with butter, honeycomb, and raspberries on a plate"
      />
      <p class="hero-caption"><a href="/gallery/milk-and-honey-part-2"><em>Milk and Honey, Part 2</em></a> &nbsp;&middot;&nbsp; Oil on canvas</p>
      <div class="exhibit-info">
        <p class="exhibit-label">Now on exhibition</p>
        <p class="exhibit-name">76th Annual Academic Artists Association Exhibition of Traditional Realism</p>
        <p class="exhibit-venue">New Hartford Art Gallery &nbsp;&middot;&nbsp; October 3&ndash;31, 2026</p>
      </div>
    </div>
    <h1 class="hero-title">Shel's Art</h1>
    <p class="hero-sub">Oil on canvas originals &nbsp;&middot;&nbsp; Prints available</p>
    <div class="hero-links">
      <div class="gallery-dropdown">
        <button type="button" class="btn-primary">View Gallery</button>
        <ul class="gallery-dropdown-menu">
          <li><a href="/gallery/still-lifes">Still Lifes</a></li>
          <li><a href="/gallery/landscapes">Landscapes</a></li>
          <li><a href="/gallery/religious">Religious</a></li>
        </ul>
      </div>
    </div>
    <p class="hero-byline">Originals and prints coming soon for sale &nbsp;&middot;&nbsp; <a href="/shop">inquire about a piece</a></p>
  </section>

  <!-- Second Exhibition -->
  <section class="exhibition">
    <div class="exhibition-inner">
      <p class="hero-label">Also on exhibition</p>
      <div class="hero-image">
        <img
          src="/images/IMG_0229.JPG"
          alt="Radishes 2.0 — oil on canvas still life of red radishes and greens on a grey plate, with a fork"
        />
        <p class="hero-caption"><a href="/gallery/radishes-2-0"><em>Radishes 2.0</em></a> &nbsp;&middot;&nbsp; Oil on canvas</p>
        <div class="exhibit-info">
          <p class="exhibit-label">Now on exhibition</p>
          <p class="exhibit-name">Harvest Awards Art Show<br /><em>Unseen Roots: How Food Connects Us All</em></p>
          <p class="exhibit-venue">Franklin Conservatory, Wells Barn &nbsp;&middot;&nbsp; October 8, 2026, 5:30&ndash;7:30 PM</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Artist Statement -->
  <section class="statement">
    <div class="statement-inner">
      <p>Work that moves between the classical and the surreal &mdash; still lifes painted with care, allegories rendered in oil, and scenes that linger.</p>
      <a href="/about" class="about-link">About the artist</a>
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ──────────────────────────────────── */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 4rem 2rem 5rem;
    text-align: center;
  }

  .hero-label {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 2rem;
  }

  .hero-image {
    width: 100%;
    max-width: 680px;
    box-shadow: 0 8px 40px rgba(44, 24, 16, 0.15);
    margin-bottom: 2.5rem;
  }

  .hero-image img {
    width: 100%;
    height: auto;
  }

  .hero-caption {
    margin-top: 0.75rem;
    font-size: 0.82rem;
    color: var(--muted);
    letter-spacing: 0.04em;
    text-align: center;
  }

  .hero-caption a {
    color: var(--text);
    border-bottom: 1px solid var(--subtle);
    transition: border-color 0.2s;
  }

  .hero-caption a:hover {
    border-color: var(--accent);
  }

  .exhibit-info {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--subtle);
  }

  .exhibit-label {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }

  .exhibit-name {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.05rem;
    line-height: 1.5;
    margin-bottom: 0.35rem;
  }

  .exhibit-venue {
    font-size: 0.85rem;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  /* ── Second Exhibition ─────────────────────── */
  .exhibition {
    border-top: 1px solid var(--subtle);
    padding: 4rem 2rem;
  }

  .exhibition-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .exhibition .hero-image {
    margin-bottom: 0;
  }

  .exhibition .exhibit-info {
    text-align: center;
  }

  .hero-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2.4rem, 6vw, 3.8rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .hero-sub {
    font-size: 0.95rem;
    color: var(--muted);
    letter-spacing: 0.06em;
    margin-bottom: 2.5rem;
  }

  .hero-links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero-byline {
    margin-top: 1.5rem;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .hero-byline a {
    color: var(--accent);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 1px;
    transition: color 0.2s, border-color 0.2s;
  }

  .hero-byline a:hover {
    color: var(--text);
    border-color: var(--text);
  }

  .btn-primary {
    padding: 0.75rem 2rem;
    background: var(--text);
    color: var(--bg);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: background 0.2s;
  }

  .btn-primary:hover {
    background: var(--accent);
  }

  .gallery-dropdown {
    position: relative;
  }

  .gallery-dropdown-menu {
    list-style: none;
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    min-width: 190px;
    background: var(--bg);
    border: 1px solid var(--subtle);
    box-shadow: 0 10px 28px rgba(44, 24, 16, 0.14);
    padding: 0.9rem 0 0.5rem;
    margin-top: 0.5rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.18s ease;
  }

  .gallery-dropdown-menu li + li {
    margin-top: 0.1rem;
  }

  .gallery-dropdown-menu a {
    display: block;
    padding: 0.55rem 1.25rem;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
    transition: color 0.2s, background 0.2s;
  }

  .gallery-dropdown-menu a:hover {
    color: var(--text);
    background: rgba(139, 105, 20, 0.08);
  }

  .gallery-dropdown:hover .gallery-dropdown-menu,
  .gallery-dropdown:focus-within .gallery-dropdown-menu {
    opacity: 1;
    visibility: visible;
  }

  /* ── Artist Statement ──────────────────────── */
  .statement {
    border-top: 1px solid var(--subtle);
    padding: 4rem 2rem;
  }

  .statement-inner {
    max-width: 580px;
    margin: 0 auto;
    text-align: center;
  }

  .statement-inner p {
    font-size: 1.15rem;
    font-style: italic;
    line-height: 1.9;
    margin-bottom: 1.75rem;
  }

  .about-link {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 1px;
    transition: color 0.2s, border-color 0.2s;
  }

  .about-link:hover {
    color: var(--text);
    border-color: var(--text);
  }

  /* ── Mobile ────────────────────────────────── */
  @media (max-width: 640px) {
    .hero {
      padding: 2.5rem 1.25rem 3.5rem;
    }
  }
</style>
