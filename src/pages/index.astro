---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Shel's Art — Original Oil Paintings">

  <!-- Hero -->
  <section class="hero">
    <p class="hero-label">Original Oil Paintings</p>
    <div class="hero-image">
      <img
        src="/images/IMG_0007.JPG"
        alt="Milk and Honey — oil on canvas still life with ceramic pitcher, tangerine, and bread"
      />
      <p class="hero-caption"><em>Milk and Honey</em> &nbsp;&middot;&nbsp; Oil on canvas &nbsp;&middot;&nbsp; <span class="artprize-note">Currently exhibited at ArtPrize, Grand Rapids</span></p>
    </div>
    <h1 class="hero-title">Shel's Art</h1>
    <p class="hero-sub">Oil on canvas originals &nbsp;&middot;&nbsp; Prints available</p>
    <div class="hero-links">
      <div class="gallery-dropdown">
        <button type="button" class="btn-primary">View Gallery</button>
        <ul class="gallery-dropdown-menu">
          <li><a href="/gallery/still-lifes">Still Lifes</a></li>
          <li><a href="/gallery/landscapes">Landscapes</a></li>
          <li><a href="/gallery/religious">Religious</a></li>
        </ul>
      </div>
      <a href="/shop" class="btn-secondary">Shop Prints</a>
    </div>
  </section>

  <!-- Artist Statement -->
  <section class="statement">
    <div class="statement-inner">
      <p>Work that moves between the classical and the surreal &mdash; still lifes painted with care, allegories rendered in oil, and scenes that linger.</p>
      <a href="/about" class="about-link">About the artist</a>
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ──────────────────────────────────── */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 4rem 2rem 5rem;
    text-align: center;
  }

  .hero-label {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 2rem;
  }

  .hero-image {
    width: 100%;
    max-width: 680px;
    box-shadow: 0 8px 40px rgba(44, 24, 16, 0.15);
    margin-bottom: 2.5rem;
  }

  .hero-image img {
    width: 100%;
    height: auto;
  }

  .hero-caption {
    margin-top: 0.75rem;
    font-size: 0.82rem;
    color: var(--muted);
    letter-spacing: 0.04em;
    text-align: center;
  }

  .artprize-note {
    color: var(--accent);
  }

  .hero-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2.4rem, 6vw, 3.8rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .hero-sub {
    font-size: 0.95rem;
    color: var(--muted);
    letter-spacing: 0.06em;
    margin-bottom: 2.5rem;
  }

  .hero-links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-primary {
    padding: 0.75rem 2rem;
    background: var(--text);
    color: var(--bg);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: background 0.2s;
  }

  .btn-primary:hover {
    background: var(--accent);
  }

  .gallery-dropdown {
    position: relative;
  }

  .gallery-dropdown-menu {
    list-style: none;
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    min-width: 190px;
    background: var(--bg);
    border: 1px solid var(--subtle);
    box-shadow: 0 10px 28px rgba(44, 24, 16, 0.14);
    padding: 0.9rem 0 0.5rem;
    margin-top: 0.5rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.18s ease;
  }

  .gallery-dropdown-menu li + li {
    margin-top: 0.1rem;
  }

  .gallery-dropdown-menu a {
    display: block;
    padding: 0.55rem 1.25rem;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
    transition: color 0.2s, background 0.2s;
  }

  .gallery-dropdown-menu a:hover {
    color: var(--text);
    background: rgba(139, 105, 20, 0.08);
  }

  .gallery-dropdown:hover .gallery-dropdown-menu,
  .gallery-dropdown:focus-within .gallery-dropdown-menu {
    opacity: 1;
    visibility: visible;
  }

  .btn-secondary {
    padding: 0.75rem 2rem;
    border: 1px solid var(--subtle);
    color: var(--text);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: border-color 0.2s, color 0.2s;
  }

  .btn-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ── Artist Statement ──────────────────────── */
  .statement {
    border-top: 1px solid var(--subtle);
    padding: 4rem 2rem;
  }

  .statement-inner {
    max-width: 580px;
    margin: 0 auto;
    text-align: center;
  }

  .statement-inner p {
    font-size: 1.15rem;
    font-style: italic;
    line-height: 1.9;
    margin-bottom: 1.75rem;
  }

  .about-link {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 1px;
    transition: color 0.2s, border-color 0.2s;
  }

  .about-link:hover {
    color: var(--text);
    border-color: var(--text);
  }

  /* ── Mobile ────────────────────────────────── */
  @media (max-width: 640px) {
    .hero {
      padding: 2.5rem 1.25rem 3.5rem;
    }
  }
</style>
