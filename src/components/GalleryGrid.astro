---
const { paintings } = Astro.props;
---

<div class="gallery-grid">
  {paintings.map((p) => (
    <div class={`card ${p.slug ? 'card--linked' : ''}`}>
      {p.slug ? (
        <a href={`/gallery/${p.slug}`}>
          <div class="card-image">
            <img src={p.src} alt={p.title} />
            <div class="card-overlay">
              <span>View work</span>
            </div>
          </div>
          <div class="card-info">
            <p class="card-title">{p.title}</p>
            <p class="card-medium">
              {p.medium}
              {p.exhibition && <span class="card-note">&nbsp;&middot;&nbsp;ArtPrize 2025</span>}
            </p>
          </div>
        </a>
      ) : (
        <div>
          <div class="card-image">
            <img src={p.src} alt={p.title} />
          </div>
          <div class="card-info">
            <p class="card-title card-title--muted">{p.title}</p>
            <p class="card-medium">{p.medium}</p>
          </div>
        </div>
      )}
    </div>
  ))}
</div>

{paintings.length === 0 && (
  <p class="gallery-empty">Coming soon.</p>
)}

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 1100px;
    margin: 2rem auto 5rem;
    padding: 0 2rem;
  }

  .card a {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .card-image {
    overflow: hidden;
    position: relative;
  }

  .card-image img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.5s ease;
    display: block;
  }

  .card--linked:hover .card-image img {
    transform: scale(1.04);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(44, 24, 16, 0.45);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .card--linked:hover .card-overlay {
    opacity: 1;
  }

  .card-overlay span {
    color: #FDFAF5;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .card-info {
    padding: 0.9rem 0 0;
  }

  .card-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1rem;
    font-weight: 400;
    margin-bottom: 0.2rem;
  }

  .card-title--muted {
    color: var(--muted);
    font-style: italic;
  }

  .card-medium {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .card-note {
    color: var(--accent);
  }

  .gallery-empty {
    text-align: center;
    font-style: italic;
    color: var(--muted);
    padding: 2rem 2rem 5rem;
  }

  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (min-width: 641px) and (max-width: 900px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
