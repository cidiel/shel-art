---
const { title, subtitle = 'Original oil paintings on canvas' } = Astro.props;
---

<div class="gallery-header">
  <h1>{title}</h1>
  <p class="gallery-sub">{subtitle}</p>
</div>

<style>
  .gallery-header {
    padding: 3.5rem 2rem 2rem;
    text-align: center;
  }

  h1 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2.2rem;
    font-weight: 400;
    font-style: italic;
    margin-bottom: 0.5rem;
  }

  .gallery-sub {
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
